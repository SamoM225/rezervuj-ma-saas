APP_NAME="Booking"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://example.com
APP_TIMEZONE=Europe/Bratislava
APP_LOCALE=sk

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=booking
DB_USERNAME=
DB_PASSWORD=

CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database

# Temporary slot holds while a customer fills in the form. "redis" on a VPS
# (REDIS_HOST/REDIS_CLIENT below), "database" on shared hosting.
SLOT_HOLD_STORE=database
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
CORS_ALLOWED_ORIGINS=https://example.com

# Token for the external-cron endpoint POST /internal/scheduler/run (leave empty to disable).
SCHEDULER_TOKEN=

# Only relevant when converting an old multi-tenant database: slug of the tenant to keep.
# PRIMARY_TENANT_SLUG=

# PayPal (Subscriptions API) — sandbox|live
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_PLAN_EUR_MONTHLY=
PAYPAL_PLAN_EUR_YEARLY=
PAYPAL_PLAN_USD_MONTHLY=
PAYPAL_PLAN_USD_YEARLY=

# Platform operator shown in legal documents
OPERATOR_NAME=
OPERATOR_EMAIL=
OPERATOR_ADDRESS=
