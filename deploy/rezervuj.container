[Unit]
Description=web: rezervuj-ma.online (multi-tenant booking SaaS)
Wants=network-online.target
After=network-online.target mariadb.service redis.service

[Container]
Image=docker.io/serversideup/php:8.4-fpm-nginx
ContainerName=web-rezervuj
# Host network like the other web containers (MariaDB and Redis listen on
# 127.0.0.1 only). Another app's PHP-FPM owns port 9000, so this
# container's FPM pool and nginx are moved to 9001 via the two mounted files.
Network=host
Environment=NGINX_HTTP_PORT=8081
Environment=NGINX_HTTPS_PORT=8444
Environment=SSL_MODE=off
Environment=PHP_OPCACHE_ENABLE=1
Environment=AUTORUN_ENABLED=false
Environment=PHP_FPM_PM_CONTROL=ondemand
Environment=PHP_FPM_PM_MAX_CHILDREN=6
Environment=PHP_MEMORY_LIMIT=128M
Environment=NGINX_CLIENT_MAX_BODY_SIZE=12M
Volume=/opt/webstack/rezervuj/deploy/rezervuj-fpm-pool.conf:/usr/local/etc/php-fpm.d/zz-rezervuj-pool.conf:ro,Z
Volume=/opt/webstack/rezervuj/deploy/rezervuj-nginx-http.conf.template:/etc/nginx/site-opts.d/http.conf.template:ro,Z
Volume=/opt/webstack/booking-nginx-remoteip.conf:/etc/nginx/server-opts.d/remoteip.conf:ro,Z
Volume=/opt/webstack/booking-nginx-security.conf:/etc/nginx/server-opts.d/security.conf:ro,Z
Volume=/opt/webstack/rezervuj:/var/www/html:Z

[Service]
Restart=always
RestartSec=20
MemoryMax=320M

[Install]
WantedBy=multi-user.target default.target
