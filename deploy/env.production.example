# Production .env for /opt/webstack/rezervuj on the box. bootstrap-rezervuj.sh
# fills the __PLACEHOLDERS__; edit the MAIL_*, PAYPAL_* and OPERATOR_* lines by hand.
APP_NAME=rezervuj-ma
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=__APP_URL__
APP_LOCALE=sk
APP_FALLBACK_LOCALE=sk
APP_TIMEZONE=Europe/Bratislava

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rezervuj
DB_USERNAME=rezervuj
DB_PASSWORD=__DB_PASSWORD__

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=720
SESSION_ENCRYPT=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# switch to true once the site is served over https (set-public-url-rezervuj.sh does it)
SESSION_SECURE_COOKIE=false
# e-mails are sent during the request; no queue worker needed on the small box
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
SLOT_HOLD_STORE=redis

# --- outgoing e-mail: Brevo SMTP relay (sign-up 2FA codes, booking e-mails) ----
# Uses the same Brevo relay account as the other projects. The password is the
# Brevo SMTP key (set it on the box, do not commit it). Sender must be a Brevo
# "verified sender".
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=__BREVO_SMTP_LOGIN__
MAIL_PASSWORD=__BREVO_SMTP_KEY__
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=majerciks1004@gmail.com
MAIL_FROM_NAME="rezervuj-ma.online"

# --- paid Pro plan master switch ----------------------------------------------
# false = free-only launch (Pro shown as "coming soon", PayPal disabled).
# Set true only once PAYPAL_* below is configured.
BILLING_ENABLED=false

# --- PayPal subscriptions (only used when BILLING_ENABLED=true) ----------------
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_PLAN_EUR_MONTHLY=
PAYPAL_PLAN_EUR_YEARLY=
PAYPAL_PLAN_USD_MONTHLY=
PAYPAL_PLAN_USD_YEARLY=

# --- platform operator shown in the legal documents ----------------------------
# Free launch: leave NAME/ADDRESS blank (no personal identity published). If
# blank, the docs default to the service name + majerciks1004@gmail.com contact.
OPERATOR_NAME=
OPERATOR_EMAIL=
OPERATOR_ADDRESS=
OPERATOR_COUNTRY=SK

GDPR_RETENTION_DAYS=730
LEGAL_MIN_AGE=16
